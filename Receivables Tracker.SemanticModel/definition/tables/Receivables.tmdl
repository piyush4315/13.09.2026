	column "SD Receipt Date" =
		```
		VAR _t = TRIM ( 'Receivables'[SD Receipt Date (Text)] )
		RETURN
			IF (
				ISBLANK ( _t ) || _t = "0" || LEN ( _t ) <> 10,
				BLANK (),
				DATE ( VALUE ( MID ( _t, 7, 4 ) ), VALUE ( MID ( _t, 4, 2 ) ), VALUE ( LEFT ( _t, 2 ) ) )
			)
		```
		dataType: dateTime
		formatString: "dd/mm/yyyy"
		isDataTypeInferred
		lineageTag: f7fbd8dc-0116-47fb-ae54-12466f53a80b
		summarizeBy: none
		description: "True date parsed from 'SD Receipt Date (Text)' (dd.mm.yyyy on the sheet)."

	column "FP Receipt Date" =
		```
		VAR _t = TRIM ( 'Receivables'[FP Receipt Date (Text)] )
		RETURN
			IF (
				ISBLANK ( _t ) || _t = "0" || LEN ( _t ) <> 10,
				BLANK (),
				DATE ( VALUE ( MID ( _t, 7, 4 ) ), VALUE ( MID ( _t, 4, 2 ) ), VALUE ( LEFT ( _t, 2 ) ) )
			)
		```
		dataType: dateTime
		formatString: "dd/mm/yyyy"
		isDataTypeInferred
		lineageTag: 5c1a0443-f2d7-4023-97ae-b51a854eea96
		summarizeBy: none
		description: "True date parsed from 'FP Receipt Date (Text)'."

	column "LPP Receipt Date" =
		```
		VAR _t = TRIM ( 'Receivables'[LPP Receipt Date (Text)] )
		RETURN
			IF (
				ISBLANK ( _t ) || _t = "0" || LEN ( _t ) <> 10,
				BLANK (),
				DATE ( VALUE ( MID ( _t, 7, 4 ) ), VALUE ( MID ( _t, 4, 2 ) ), VALUE ( LEFT ( _t, 2 ) ) )
			)
		```
		dataType: dateTime
		formatString: "dd/mm/yyyy"
		isDataTypeInferred
		lineageTag: 160e631d-e676-4cb7-85d0-010e7048e4dc
		summarizeBy: none
		description: "True date parsed from 'LPP Receipt Date (Text)'."

	column "Invoice Date" =
		```
		VAR _t = TRIM ( 'Receivables'[Invoice Date (Text)] )
		RETURN
			IF (
				ISBLANK ( _t ) || _t = "0" || LEN ( _t ) <> 10,
				BLANK (),
				DATE ( VALUE ( MID ( _t, 7, 4 ) ), VALUE ( MID ( _t, 4, 2 ) ), VALUE ( LEFT ( _t, 2 ) ) )
			)
		```
		dataType: dateTime
		formatString: "dd/mm/yyyy"
		isDataTypeInferred
		lineageTag: 0ec75d8a-54fc-4414-aa5a-84f88df459ab
		summarizeBy: none
		description: "True date parsed from 'Invoice Date (Text)' (Excel column AH)."

	column "LPP Expected Calc" =
		```
		VAR _LPPStart = DATE ( 2026, 8, 22 )
		VAR _Grace = DATE ( 2026, 8, 24 )
		VAR _Received = 'Receivables'[FP Receipt Date]
		VAR _End = IF ( ISBLANK ( _Received ), TODAY (), _Received )
		VAR _Weeks = CEILING ( DIVIDE ( DATEDIFF ( _LPPStart, _End, DAY ), 7 ), 1 )
		RETURN
			IF (
				NOT ISBLANK ( _Received ) && _Received <= _Grace,
				0,
				'Receivables'[Material Value] * 0.0118 * _Weeks
			)
		```
		dataType: double
		formatString: "#,##0.00"
		isDataTypeInferred
		isHidden
		lineageTag: 59c6bbfc-6b8a-47ad-bebb-7635a3d62c80
		summarizeBy: sum
		description: "Row-level late payment penalty. Hidden - consumed by [Outstanding Calc]."

	column "Outstanding Calc" =
		```
		VAR _MatValue = 'Receivables'[Material Value]
		VAR _GstTds = ROUND ( _MatValue * 'Receivables'[GST TDS Rate], 0 )
		VAR _Lpp = 'Receivables'[LPP Expected Calc]
		VAR _Receivable = ROUND ( _MatValue * 1.1765 - _GstTds + _Lpp, 0 )
		VAR _Received =
			COALESCE ( 'Receivables'[Security Deposit (Received)], 0 )
				+ COALESCE ( 'Receivables'[Final Payment (Received)], 0 )
				+ COALESCE ( 'Receivables'[LPP Received], 0 )
		RETURN
			_Receivable - _Received
		```
		dataType: double
		formatString: "#,##0.00"
		isDataTypeInferred
		isHidden
		lineageTag: aefa14fd-404b-4060-a745-7b2bdcf89a34
		summarizeBy: sum
		description: "Row-level outstanding amount. Hidden - consumed by the payment-status measures."

	column "Payment Status" =
		```
		IF ( 'Receivables'[Outstanding Calc] <= 5, "SETTLED", "OUTSTANDING" )
		```
		dataType: string
		isDataTypeInferred
		lineageTag: a830717c-2587-4fe6-b559-7d63fb018553
		summarizeBy: none
		description: "SETTLED when the row-level Outstanding is 5 or less, otherwise OUTSTANDING. Recomputed from the inputs; mirrors Excel column AE. Compare with [Payment Status (Sheet)] to spot rows the spreadsheet has not recalculated."

	measure "Lot Count" =
		```
		COUNTROWS ( 'Receivables' )
		```
		formatString: "#,##0"
		lineageTag: 262833d8-5bb1-47b4-90a7-c281c4009e17
		description: "Number of lots in the current filter context."

	measure "Material Value" =
		```
		SUM ( 'Receivables'[Material Value] )
		```
		formatString: "#,##0"
		lineageTag: 2c78074d-65a9-45d0-9f67-c3c1454de93d
		description: "Excel column H - auction material value before tax."

	measure "GST" =
		```
		SUMX ( 'Receivables', ROUND ( 'Receivables'[Material Value] * 0.18, 0 ) )
		```
		formatString: "#,##0"
		lineageTag: de4cf0aa-61bd-4c1e-b94c-ee9cb1591279
		description: "Excel column I - ROUND( Material Value * 18%, 0 )."

	measure "Material Value incl. GST" =
		```
		SUMX (
			'Receivables',
			'Receivables'[Material Value] + ROUND ( 'Receivables'[Material Value] * 0.18, 0 )
		)
		```
		formatString: "#,##0"
		lineageTag: 1b099ccf-c94a-4b43-bc9c-07dc16c07a4c
		description: "Excel column J - Material Value + GST."

	measure "TCS" =
		```
		SUMX (
			'Receivables',
			ROUND ( ( 'Receivables'[Material Value] + ROUND ( 'Receivables'[Material Value] * 0.18, 0 ) ) * 0.02, 0 )
		)
		```
		formatString: "#,##0"
		lineageTag: 7cfeb662-28b8-42d5-9e27-ee8a6a1d26b2
		description: "Excel column K - ROUND( ( Material Value + GST ) * 2%, 0 )."

	measure "TDS u/s 194(O)" =
		```
		SUMX ( 'Receivables', 'Receivables'[Material Value] * 0.001 )
		```
		formatString: "#,##0.00"
		lineageTag: 82748ddc-57b3-4023-a314-5d4ac13c210a
		description: "Excel column L - Material Value * 0.1% (source is not rounded)."

	measure "Service Charge to MSTC" =
		```
		SUMX ( 'Receivables', 'Receivables'[Material Value] * 0.0225 * 1.18 )
		```
		formatString: "#,##0.00"
		lineageTag: 9f10d05e-fc14-4f15-abfa-864ec2ec7abf
		description: "Excel column M - Material Value * 2.25% * 118%."

	measure "TDS u/s 194(H)" =
		```
		SUMX ( 'Receivables', 'Receivables'[Material Value] * 0.0225 * 0.02 )
		```
		formatString: "#,##0.00"
		lineageTag: 4333c7f3-5af1-4b13-9575-8140926fd348
		description: "Excel column N - Material Value * 2.25% * 2%."

	measure "Net Service Charge" =
		```
		SUMX ( 'Receivables', 'Receivables'[Material Value] * 0.0225 * ( 1.18 - 0.02 ) )
		```
		formatString: "#,##0.00"
		lineageTag: 7a1f5ce6-abea-4457-927d-a163966f14e0
		description: "Excel column O - Service Charge to MSTC - TDS u/s 194(H)."

	measure "Service Charge to MSTC (Net)" =
		```
		SUMX (
			'Receivables',
			ROUND ( 'Receivables'[Material Value] * 0.0225 * ( 1.18 - 0.02 ) + 'Receivables'[Material Value] * 0.001, 0 )
		)
		```
		formatString: "#,##0"
		lineageTag: 8f4d936f-3604-4f54-9407-51ff42f4199d
		description: "Excel column P - ROUND( Net Service Charge + TDS u/s 194(O), 0 )."

	measure "GST TDS" =
		```
		SUMX ( 'Receivables', ROUND ( 'Receivables'[Material Value] * 'Receivables'[GST TDS Rate], 0 ) )
		```
		formatString: "#,##0"
		lineageTag: de694538-d58c-4af8-8071-2afefed7ae2a
		description: "Excel column R - ROUND( Material Value * GST TDS Rate, 0 )."

	measure "LPP Expected" =
		```
		SUMX ( 'Receivables', 'Receivables'[LPP Expected Calc] )
		```
		formatString: "#,##0.00"
		lineageTag: a5f5bc65-ffd7-4194-a438-ab24948e5a9c
		description: "Excel column Z - late payment penalty: 1.18% of Material Value per started week from 22-Aug-2026 to the final-payment receipt date (grace to 24-Aug-2026); accrues to today while unpaid."

	measure "Security Deposit (Expected)" =
		```
		SUMX ( 'Receivables', ROUND ( 'Receivables'[Material Value] * 0.25, 0 ) )
		```
		formatString: "#,##0"
		lineageTag: 41139464-f788-4331-96ce-db45e6cf78f7
		description: "Excel column T - ROUND( Material Value * 25%, 0 )."

	measure "Security Deposit (Received)" =
		```
		SUM ( 'Receivables'[Security Deposit (Received)] )
		```
		formatString: "#,##0"
		lineageTag: 29d784ee-7d8b-4157-9ef6-e4bf0f5e6635
		description: "Excel column U - as entered on the sheet."

	measure "Final Payment (Expected)" =
		```
		SUMX (
			'Receivables',
			ROUND ( 'Receivables'[Material Value] * 0.9265 - ROUND ( 'Receivables'[Material Value] * 'Receivables'[GST TDS Rate], 0 ), 0 )
		)
		```
		formatString: "#,##0"
		lineageTag: 9e280ad4-9035-4137-bba6-9405b8a15ce6
		description: "Excel column W - ROUND( Material Value * 92.65% - GST TDS, 0 )."

	measure "Final Payment (Received)" =
		```
		SUM ( 'Receivables'[Final Payment (Received)] )
		```
		formatString: "#,##0.00"
		lineageTag: 5b358ea3-ca54-4aaa-ab66-d3898ddee429
		description: "Excel column X - as entered on the sheet."

	measure "LPP Received" =
		```
		SUM ( 'Receivables'[LPP Received] )
		```
		formatString: "#,##0.00"
		lineageTag: 1b5218a8-70ef-4d62-9b41-78fdb0be20ce
		description: "Excel column AA - late payment penalty actually received."

	measure "Total Receivables in Cash" =
		```
		SUMX (
			'Receivables',
			ROUND (
				'Receivables'[Material Value] * 1.1765
					- ROUND ( 'Receivables'[Material Value] * 'Receivables'[GST TDS Rate], 0 )
					+ 'Receivables'[LPP Expected Calc],
				0
			)
		)
		```
		formatString: "#,##0"
		lineageTag: 8dd69a7c-a157-4838-b724-564ba2c060e1
		description: "Excel column S - ROUND( Material Value * 117.65% - GST TDS + LPP Expected, 0 )."

	measure "Total Received" =
		```
		SUMX (
			'Receivables',
			COALESCE ( 'Receivables'[Security Deposit (Received)], 0 )
				+ COALESCE ( 'Receivables'[Final Payment (Received)], 0 )
				+ COALESCE ( 'Receivables'[LPP Received], 0 )
		)
		```
		formatString: "#,##0.00"
		lineageTag: 6e2eb056-adaf-42d4-8f12-b92f0bfe0e28
		description: "Excel column AC - Security Deposit (Received) + Final Payment (Received) + LPP Received."

	measure "Outstanding" =
		```
		[Total Receivables in Cash] - [Total Received]
		```
		formatString: "#,##0.00"
		lineageTag: e1226448-b6b6-4100-aee4-75a975b19997
		description: "Excel column AD - Total Receivables in Cash - Total Received."

	measure "Recovery %" =
		```
		DIVIDE ( [Total Received], [Total Receivables in Cash] )
		```
		formatString: "0.0%"
		lineageTag: 234c7e40-0097-4b29-bfa7-eb1f79f5ace7
		description: "Total Received as a percentage of Total Receivables in Cash."

	measure "Lots Settled" =
		```
		COUNTROWS ( FILTER ( 'Receivables', 'Receivables'[Outstanding Calc] <= 5 ) )
		```
		formatString: "#,##0"
		lineageTag: 08e150e5-3a5c-4862-85d2-0a8f107af1aa
		description: "Excel column AE - lots whose Outstanding is 5 or less."

	measure "Lots Outstanding" =
		```
		COUNTROWS ( FILTER ( 'Receivables', 'Receivables'[Outstanding Calc] > 5 ) )
		```
		formatString: "#,##0"
		lineageTag: 9d47f07e-13a5-4404-a355-4d14c6683566
		description: "Excel column AE - lots whose Outstanding is above 5."

	measure "Lots Missing Invoice Details" =
		```
		COUNTROWS (
			FILTER (
				'Receivables',
				ISBLANK ( 'Receivables'[Invoice No.] )
					|| ISBLANK ( 'Receivables'[SAP Document] )
					|| ISBLANK ( 'Receivables'[Invoice Date] )
			)
		)
		```
		formatString: "#,##0"
		lineageTag: bb81c2b3-4a35-4d3c-906e-e78337a62ca7
		description: "Lots with no Invoice No., SAP Document or Invoice Date."

	measure "Over-Receipts" =
		```
		SUMX ( FILTER ( 'Receivables', 'Receivables'[Outstanding Calc] < 0 ), - 'Receivables'[Outstanding Calc] )
		```
		formatString: "#,##0.00"
		lineageTag: e0b2e203-613a-4735-903b-fe270aa0886b
		description: "Received in excess of Total Receivables in Cash (negative Outstanding)."

	measure "Lots Without FP Receipt Date" =
		```
		COUNTROWS ( FILTER ( 'Receivables', ISBLANK ( 'Receivables'[FP Receipt Date] ) ) )
		```
		formatString: "#,##0"
		lineageTag: c6e1f295-9126-467e-80d3-75e18f1b3ae3
		description: "Lots with no final-payment receipt date entered."

	measure "Lots With Zero GST TDS Rate" =
		```
		COUNTROWS ( FILTER ( 'Receivables', 'Receivables'[GST TDS Rate] = 0 ) )
		```
		formatString: "#,##0"
		lineageTag: b11ee027-8a88-43e4-ab36-8ef1c40f8050
		description: "Lots where the GST TDS Rate is 0."
