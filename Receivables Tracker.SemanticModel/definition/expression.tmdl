shared expression Receivables =
	```
		let
			CsvBase64 = "",
			Source = Csv.Document(Binary.FromText(CsvBase64), [Delimiter = ",", Encoding = 65001]),
			Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			Typed = Table.TransformColumnTypes(
				Promoted,
							{
							{"Quantity", type number},
							{"Lot Name", type nullable text},
							{"Rate", type number},
							{"Bid Sheet", Int64.Type},
							{"Unit", type nullable text},
							{"Lot No.", Int64.Type},
							{"Buyer", type nullable text},
							{"Material Value", Int64.Type},
							{"GST TDS Rate", type number},
							{"Security Deposit (Received)", type number},
							{"SD Receipt Date (Text)", type nullable text},
							{"Final Payment (Received)", type number},
							{"FP Receipt Date (Text)", type nullable text},
							{"LPP Received", type number},
							{"LPP Receipt Date (Text)", type nullable text},
							{"Payment Status (Sheet)", type nullable text},
							{"Invoice No.", type nullable text},
							{"SAP Document", type nullable text},
							{"Invoice Date (Text)", type nullable text}
							}
			)
		in
			Typed
		```

// Alternative loader - reads Data/receivables.csv from the project folder.
// Point the Receivables partition at ReceivablesFromCsv to refresh from the CSV.
shared expression ReceivablesFromCsv =
	```
		let
			ProjectRoot = Text.BeforeDelimiter(Text.From(#section[Section1][ReceivablesFromCsv][Meta][ConceptualRelativePath]), "/", {0, -1}),
			CsvPath = Text.Combine({ProjectRoot, "Data", "receivables.csv"}, "/"),
			Source = Csv.Document(File.Contents(CsvPath), [Delimiter = ",", Encoding = 65001]),
			Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			Typed = Table.TransformColumnTypes(
				Promoted,
							{
							{"Quantity", type number},
							{"Lot Name", type nullable text},
							{"Rate", type number},
							{"Bid Sheet", Int64.Type},
							{"Unit", type nullable text},
							{"Lot No.", Int64.Type},
							{"Buyer", type nullable text},
							{"Material Value", Int64.Type},
							{"GST TDS Rate", type number},
							{"Security Deposit (Received)", type number},
							{"SD Receipt Date (Text)", type nullable text},
							{"Final Payment (Received)", type number},
							{"FP Receipt Date (Text)", type nullable text},
							{"LPP Received", type number},
							{"LPP Receipt Date (Text)", type nullable text},
							{"Payment Status (Sheet)", type nullable text},
							{"Invoice No.", type nullable text},
							{"SAP Document", type nullable text},
							{"Invoice Date (Text)", type nullable text}
							}
			)
		in
			Typed
		```
